# ===== Maverick — example env. Copy to .env and fill in. NEVER commit .env. =====
NODE_ENV=production
PORT=3000
TZ=America/Chicago
BRAND_NAME=Maverick
SESSION_SECRET=change-me-to-a-long-random-hex

# --- Google SSO (login identity; gated to one email) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://maverick.example.com/auth/callback
ALLOWED_GOOGLE_EMAILS=you@example.com

# --- Claude Code subscription brain (long-lived OAuth token) ---
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CONFIG_DIR=/home/node/.claude
MAVERICK_MODEL=claude-sonnet-4-6

# --- storage ---
MAVERICK_DB_PATH=/app/data/maverick.db

# --- ntfy (reminders / notifications) ---
NTFY_URL=http://ntfy:80
NTFY_TOPIC=maverick
NTFY_TOKEN=

# --- timeclock agent API (optional; read + propose) ---
TIMECLOCK_URL=http://timeclock:3000
AGENT_API_TOKEN=

# --- optional integrations (blank = disabled) ---
BOOKMARKS_URL=http://bookmarks:3000
BOOKMARKS_AGENT_TOKEN=
CHARLIEWORK_API_URL=
CHARLIEWORK_API_TOKEN=
ENABLE_DOCKER_TOOL=false

# --- watch device pairing token (Amazfit Active 2 mini program) ---
DEVICE_TOKEN=

# Google API key (YouTube Data, Maps). Leave blank to disable those.
GOOGLE_API_KEY=

# Self-hosted Whisper STT (internal)
WHISPER_URL=http://maverick-whisper:9000

# Calendars to always treat as work/resource (comma-separated, substring match)
WORK_CALENDARS=
