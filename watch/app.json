{
  "configVersion": "v3",
  "app": {
    "appId": 31415,
    "appName": "Maverick",
    "appType": "app",
    "version": { "code": 1, "name": "0.1.0" },
    "icon": "icon.png",
    "vender": "matthewgisi",
    "description": "Glance at your day and dictate to Maverick from your wrist."
  },
  "permissions": ["device:os.mic"],
  "runtime": {
    "apiVersion": { "compatible": "4.0", "target": "4.0", "minVersion": "4.0" }
  },
  "targets": {
    "default": {
      "module": {
        "page": { "pages": ["page/index"] },
        "app-side": { "path": "app-side/index" }
      },
      "platforms": [
        { "st": "r", "dw": 480 }
      ]
    }
  },
  "i18n": {
    "en-US": { "appName": "Maverick" }
  },
  "defaultLanguage": "en-US"
}
